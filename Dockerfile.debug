# Debug version to check build output
FROM node:18-alpine AS builder

# Set working directory
WORKDIR /app

# Install Vue CLI globally
RUN npm install -g @vue/cli

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Build the uni-app for H5
RUN npm run build:h5 || echo "Build failed"

# Debug: List all files and directories
RUN echo "📂 Listing all files in /app:" && ls -R /app || echo "Failed to list files"

# Debug: Check specific paths
RUN echo "📂 Checking /app/unpackage:" && ls -la /app/unpackage || echo "/app/unpackage not found"
RUN echo "📂 Checking /app/unpackage/dist:" && ls -la /app/unpackage/dist || echo "/app/unpackage/dist not found"
RUN echo "📂 Checking /app/unpackage/dist/build/h5:" && ls -la /app/unpackage/dist/build/h5 || echo "/app/unpackage/dist/build/h5 not found"
RUN echo "📂 Checking /app/unpackage/dist/dev/h5:" && ls -la /app/unpackage/dist/dev/h5 || echo "/app/unpackage/dist/dev/h5 not found"

# Production stage
FROM nginx:alpine

# Copy custom nginx config
COPY nginx.conf /etc/nginx/nginx.conf

# Try different possible paths for uni-app H5 build
COPY --from=builder /app/unpackage/dist/build/h5 /usr/share/nginx/html

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
